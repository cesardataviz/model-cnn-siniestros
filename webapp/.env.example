# Copiar a .env.local para desarrollo, o configurar como Environment Variables en Vercel.
# NUNCA exponer DATABRICKS_TOKEN al cliente -- por eso vive solo en el servidor
# (route handler de app/api/predict), nunca en una variable NEXT_PUBLIC_*.

DATABRICKS_HOST=https://<tu-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi************************

# Deben coincidir con ENDPOINT_NAME_CNN / ENDPOINT_NAME_RESNET de notebooks/00_config.py
DATABRICKS_ENDPOINT_CNN=car-damage-cnn-scratch
DATABRICKS_ENDPOINT_RESNET=car-damage-resnet18
